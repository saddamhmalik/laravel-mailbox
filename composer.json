{
    "name": "laravel-mailbox/mailbox",
    "version": "1.0.0",
    "description": "A modern email testing and preview tool deeply integrated into Laravel.",
    "keywords": [
        "laravel",
        "mail",
        "email",
        "testing",
        "mailbox",
        "mailhog",
        "mailpit"
    ],
    "license": "MIT",
    "homepage": "https://github.com/saddamhmalik/laravel-mailbox",
    "support": {
        "issues": "https://github.com/saddamhmalik/laravel-mailbox/issues",
        "source": "https://github.com/saddamhmalik/laravel-mailbox"
    },
    "authors": [
        {
            "name": "Saddam Malik",
            "email": "saddamhmalik@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "livewire/livewire": "^3.5",
        "spatie/laravel-package-tools": "^1.18",
        "symfony/mailer": "^7.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelMailbox\\": "src/"
        },
        "files": [
            "src/Testing/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelMailbox\\Tests\\": "tests/",
            "Workbench\\": "workbench/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelMailbox\\Providers\\MailboxServiceProvider"
            ],
            "aliases": {
                "Mailbox": "LaravelMailbox\\Facades\\Mailbox"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "root-version": "1.0.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "setup": [
            "@php scripts/ensure-workbench-dirs.php",
            "@php vendor/bin/testbench package:create-sqlite-db",
            "@php vendor/bin/testbench migrate --force",
            "@php scripts/seed-workbench.php"
        ],
        "serve": [
            "@php vendor/bin/testbench serve --host=127.0.0.1 --port=8888"
        ],
        "test": [
            "@php scripts/clean-testbench-migrations.php",
            "pest"
        ],
        "test-coverage": "pest --coverage",
        "analyse": "phpstan analyse",
        "format": "pint",
        "rector": "rector process",
        "build-assets": "npm run build"
    }
}
